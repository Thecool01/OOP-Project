							"parentStyle": false,
							"left": 4816,
							"top": 4160,
							"width": 408,
							"height": 136,
							"text": "UniversityFacade uses Facade pattern because it provides one simple interface for Main and hides internal services of the system."
						},
						{
							"_type": "UMLNoteLinkView",
							"_id": "AAAAAAGeNT6AgFUnwtY=",
