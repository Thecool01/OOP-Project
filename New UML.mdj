							"parentStyle": false,
							"left": 1208,
							"top": 4056,
							"width": 472,
							"height": 80,
							"text": "UniversitySystem uses Singleton pattern because the system must have one central object that stores users, courses, requests, projects and logs."
						},
						{
							"_type": "UMLNoteLinkView",
